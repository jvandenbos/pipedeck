post_install() {
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  # A package cannot enable a user service for every user.
  echo ":: Start the daemon for your user: systemctl --user enable --now pipedeckd"
  echo ":: PipeDeck (pipedeck-ui) is in the app launcher."
}

post_upgrade() {
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  return 0
}

post_remove() {
  post_upgrade
}
